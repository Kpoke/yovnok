# HTTPS for YOVNOK. Two sites:
#
#   {$DOMAIN}     the page and its files, through Cloudflare (SSL "Full
#                 (strict)", Cloudflare origin certificate). Requests that did
#                 not come from Cloudflare's addresses ({$CF_RANGES}) are
#                 dropped, so the files are always served — and cached — by
#                 Cloudflare.
#   {$WS_DOMAIN}  the live game socket ONLY (/ws), reached directly (DNS-only),
#                 for the lowest round trip. Let's Encrypt certificate, issued
#                 automatically. Cloudflare's client headers are stripped here,
#                 so a direct client cannot fake its address or country.

{$DOMAIN} {
	tls /etc/caddy/origin.pem /etc/caddy/origin.key
	@notCloudflare not remote_ip {$CF_RANGES}
	abort @notCloudflare
	encode zstd gzip
	reverse_proxy game:8787
}

{$WS_DOMAIN} {
	@socket path /ws
	handle @socket {
		reverse_proxy game:8787 {
			header_up -Cf-Connecting-Ip
			header_up -Cf-Ipcountry
		}
	}
	handle {
		abort
	}
}
